Services.ProximityPrompt.PromptTriggered:Connect(function(prompt)
    -- print("[PoC] Prompt Triggered (instant):", prompt:GetFullName())
end)
-- ── State ────────────────────────────────────────────────────────────
local State = {
    ESPEnabled          = false,
    WalkEnabled         = false,
    WalkValue           = 40,
    JumpEnabled         = false,
    JumpValue           = 20,
    AutoRefreshEnabled  = false,
}

-- Store current defaults – updated on each respawn
local OriginalWalkSpeed = 16
local OriginalJumpPower = 20

-- ── ESP Data ──────────────────────────────────────────────────────
local ESPData = {}

-- ── Helper Functions ──────────────────────────────────────────────

local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

-- Robust team detection: checks TeamColor first, then Team.
local function isTeammate(plr)
    if not plr then return false end
    local myColor = LocalPlayer.TeamColor
    local theirColor = plr.TeamColor
    if myColor and theirColor and myColor == theirColor then
        return true
    end
    -- Fallback: check Team property
    local myTeam = LocalPlayer.Team
    local theirTeam = plr.Team
    if myTeam and theirTeam and myTeam == theirTeam then
        return true
    end
    return false
end

-- ── Save Game Defaults (called on each respawn) ─────────────────

local function saveOriginalValues()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = getHumanoid(char)
    if hum then
        OriginalWalkSpeed = hum.WalkSpeed
        if hum.UseJumpPower then
            OriginalJumpPower = hum.JumpPower
        else
            OriginalJumpPower = hum.JumpHeight or 50
        end
    end
end

-- ── ESP Creation ──────────────────────────────────────────────────

local function createESPForPlayer(plr)
    if plr == LocalPlayer then return end
    -- Remove old ESP if exists
    if ESPData[plr] then
        local data = ESPData[plr]
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        ESPData[plr] = nil
    end

    local char = plr.Character
    if not char then return end
    local root = getRoot(char)
    if not root then return end

    -- Highlight with team color
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Parent = char
    local isTeam = isTeammate(plr)
    highlight.FillColor = isTeam and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 50, 50)
    highlight.FillTransparency = 0.4
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    -- BillboardGui (Distance on top, Name below)
    local head = char:FindFirstChild("Head")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Billboard"
    billboard.Parent = CoreGui
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 70)
    billboard.StudsOffset = Vector3.new(0, 4.5, 0)
    billboard.AlwaysOnTop = true

    local label = Instance.new("TextLabel")
    label.Parent = billboard
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 16
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.Text = "0\n" .. plr.Name

    ESPData[plr] = {
        Highlight = highlight,
        Billboard = billboard,
        Label = label,
        Character = char,
        LastTeammate = isTeam,
    }
end

-- ── Remove ESP ──────────────────────────────────────────────────

local function removeESPForPlayer(plr)
    local data = ESPData[plr]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        ESPData[plr] = nil
    end
end

-- ── Update all ESP (distance & team color) ────────────────────────

local function updateAllESP()
    if not State.ESPEnabled then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and getRoot(myChar)
    if not myRoot then return end

    for plr, data in pairs(ESPData) do
        -- Recreate if character changed or is nil
        if not data.Character or plr.Character ~= data.Character then
            createESPForPlayer(plr)
            data = ESPData[plr]
            if not data then continue end
        end

        -- Update distance
        local targetRoot = getRoot(plr.Character)
        if targetRoot then
            local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
            data.Label.Text = dist .. "\n" .. plr.Name
        end

        -- Update team color if status changed
        local nowTeammate = isTeammate(plr)
        if data.LastTeammate ~= nowTeammate then
            data.LastTeammate = nowTeammate
            local highlight = data.Highlight
            if highlight then
                highlight.FillColor = nowTeammate and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 50, 50)
            end
        end
    end
end

-- ── Refresh ESP (full rebuild) ──────────────────────────────────

local function refreshESP()
    for plr in pairs(ESPData) do removeESPForPlayer(plr) end
    if State.ESPEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then createESPForPlayer(plr) end
        end
    end
end

-- ── Event Listeners for ESP ──────────────────────────────────────

Players.PlayerAdded:Connect(function(plr)
    if State.ESPEnabled and plr ~= LocalPlayer then createESPForPlayer(plr) end
end)

Players.PlayerRemoving:Connect(function(plr)
    removeESPForPlayer(plr)
end)

-- Other players respawn
local function onOtherPlayerCharacterAdded(plr)
    if State.ESPEnabled and plr ~= LocalPlayer then createESPForPlayer(plr) end
end

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        plr.CharacterAdded:Connect(function()
            onOtherPlayerCharacterAdded(plr)
        end)
    end
end

-- ── Throttled Update Loop ────────────────────────────────────────

local updateConnection
local lastUpdateTime = 0

local function startUpdateLoop()
    if updateConnection then
        updateConnection:Disconnect()
        updateConnection = nil
    end
    if State.ESPEnabled then
        updateConnection = RunService.Stepped:Connect(function()
            local now = tick()
            if now - lastUpdateTime >= 0.5 then
                lastUpdateTime = now
                updateAllESP()
            end
        end)
    end
end

-- ── Auto Refresh ESP Loop ────────────────────────────────────────

local autoRefreshConnection = nil

local function autoRefreshLoop()
    while State.AutoRefreshEnabled do
        if State.ESPEnabled and ESPToggleRef then
            -- Toggle ESP off
            ESPToggleRef:SetValue(false)
            task.wait(0.1)
            -- Toggle ESP back on
            ESPToggleRef:SetValue(true)
        end
        -- Wait 5 seconds (50 * 0.1)
        for _ = 1, 50 do
            if not State.AutoRefreshEnabled then return end
            task.wait(0.1)
        end
    end
end

-- ── WalkSpeed (Persistent) ──────────────────────────────────────

local WalkCons = {
    property = nil,
    charAdded = nil,
}

local function applyWalkSpeed(humanoid)
    if not humanoid then return end
    if State.WalkEnabled then
        humanoid.WalkSpeed = State.WalkValue
        if WalkCons.property then
            WalkCons.property:Disconnect()
            WalkCons.property = nil
        end
        WalkCons.property = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            applyWalkSpeed(humanoid)
        end)
    else
        humanoid.WalkSpeed = OriginalWalkSpeed
        if WalkCons.property then
            WalkCons.property:Disconnect()
            WalkCons.property = nil
        end
    end
end

-- ── Jump Power (Persistent) ─────────────────────────────────────

local JumpCons = {
    property = nil,
    property2 = nil,
    charAdded = nil,
}

local function applyJump(humanoid)
    if not humanoid then return end
    if State.JumpEnabled then
        local val = State.JumpValue
        if humanoid.UseJumpPower then
            humanoid.JumpPower = val
        else
            humanoid.JumpHeight = val
        end
        if JumpCons.property then
            JumpCons.property:Disconnect()
            JumpCons.property = nil
        end
        if JumpCons.property2 then
            JumpCons.property2:Disconnect()
            JumpCons.property2 = nil
        end
        JumpCons.property = humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
            applyJump(humanoid)
        end)
        JumpCons.property2 = humanoid:GetPropertyChangedSignal("JumpHeight"):Connect(function()
            applyJump(humanoid)
        end)
    else
        if humanoid.UseJumpPower then
            humanoid.JumpPower = OriginalJumpPower
        else
            humanoid.JumpHeight = OriginalJumpPower
        end
        if JumpCons.property then
            JumpCons.property:Disconnect()
            JumpCons.property = nil
        end
        if JumpCons.property2 then
            JumpCons.property2:Disconnect()
            JumpCons.property2 = nil
        end
    end
end

-- ── Local Respawn Handler ────────────────────────────────────────

local function onLocalCharacterAdded(newChar)
    local humanoid = newChar:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    saveOriginalValues()
    applyWalkSpeed(humanoid)
    applyJump(humanoid)

    -- Force refresh ESP for all players on local respawn
    if State.ESPEnabled then
        task.wait(0.1)
        refreshESP()
        startUpdateLoop()
    end
end

LocalPlayer.CharacterAdded:Connect(onLocalCharacterAdded)

-- Initial setup if character already exists
if LocalPlayer.Character then
    task.wait(0.2)
    onLocalCharacterAdded(LocalPlayer.Character)
end

-- ── UI Setup ────────────────────────────────────────────────────────

local Window = Fluent:CreateWindow({
    Title = "Player Tools",
    SubTitle = "ESP, WalkSpeed, Jump, Auto Refresh",
    TabWidth = 160,
    Size = UDim2.fromOffset(520, 240),
    Acrylic = false,
    Theme = "Neon Purple",
    MinimizeKey = Enum.KeyCode.LeftAlt,
})

local PlayerTab = Window:AddTab({ Title = "Player", Icon = "user-cog" })

-- ESP Toggle (store reference)
local ESPToggleRef = PlayerTab:AddToggle("ESPToggle", {
    Title = "ESP",
    Description = "Team‑based highlights: Green (ally) / Red (enemy)",
    Default = false,
    Callback = function(enabled)
        State.ESPEnabled = enabled
        if enabled then
            refreshESP()
            startUpdateLoop()
        else
            for plr in pairs(ESPData) do removeESPForPlayer(plr) end
            if updateConnection then
                updateConnection:Disconnect()
                updateConnection = nil
            end
        end
    end,
})

-- Auto Refresh ESP Toggle
PlayerTab:AddToggle("AutoRefreshToggle", {
    Title = "Auto Refresh ESP",
    Description = "Automatically refresh ESP every 5 seconds (off/on)",
    Default = false,
    Callback = function(enabled)
        State.AutoRefreshEnabled = enabled
        if enabled then
            if autoRefreshConnection then
                autoRefreshConnection:Disconnect()
                autoRefreshConnection = nil
            end
            autoRefreshConnection = task.spawn(autoRefreshLoop)
        else
            if autoRefreshConnection then
                task.cancel(autoRefreshConnection)
                autoRefreshConnection = nil
            end
        end
    end,
})

-- WalkSpeed Toggle
PlayerTab:AddToggle("WalkToggle", {
    Title = "WalkSpeed",
    Description = "Persistent walk speed modification",
    Default = false,
    Callback = function(enabled)
        State.WalkEnabled = enabled
        local hum = getHumanoid(LocalPlayer.Character)
        if hum then applyWalkSpeed(hum) end
    end,
})

PlayerTab:AddSlider("WalkSlider", {
    Title = "Walk Speed",
    Description = "Adjust speed (default 40)",
    Default = 40,
    Min = 1,
    Max = 60,
    Rounding = 1,
    Callback = function(value)
        State.WalkValue = value
        if State.WalkEnabled then
            local hum = getHumanoid(LocalPlayer.Character)
            if hum then applyWalkSpeed(hum) end
        end
    end,
})

-- Jump Power Toggle
PlayerTab:AddToggle("JumpToggle", {
    Title = "Jump Power",
    Description = "Persistent jump modification (resists resets)",
    Default = false,
    Callback = function(enabled)
        State.JumpEnabled = enabled
        local hum = getHumanoid(LocalPlayer.Character)
        if hum then applyJump(hum) end
    end,
})

PlayerTab:AddSlider("JumpSlider", {
    Title = "Jump Value",
    Description = "JumpPower or JumpHeight (depending on game)",
    Default = 20,
    Min = 0,
    Max = 50,
    Rounding = 0,
