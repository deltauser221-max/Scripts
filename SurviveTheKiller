        State.JumpEnabled = enabled
        applyJump()
        if enabled then
            if not JumpCons.charAdded then
                JumpCons.charAdded = LocalPlayer.CharacterAdded:Connect(onJumpCharacterAdded)
            end
        else
            if JumpCons.charAdded then
                JumpCons.charAdded:Disconnect()
                JumpCons.charAdded = nil
            end
        end
    end,
})

PlayerTab:AddSlider("JumpSlider", {
    Title = "Jump Value",
    Description = "JumpPower or JumpHeight (depending on game)",
    Default = 20,
    Min = 0,
    Max = 60,
    Rounding = 0,
    Callback = function(value)
        State.JumpValue = value
        if State.JumpEnabled then applyJump() end
    end,
})

