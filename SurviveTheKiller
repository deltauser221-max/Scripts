local PlayerTab = Window:AddTab({ Title = "Player", Icon = "user-cog" })

-- ESP Toggle
PlayerTab:AddToggle("ESPToggle", {
    Title = "ESP",
    Description = "Team‑based highlights: Green (ally) / Red (enemy)",
    Default = false,
    Callback = function(enabled)
        State.ESPEnabled = enabled
        if enabled then
            refreshESP()
            startUpdateLoop()
        else
            for plr in pairs(ESPData) do removeESPForPlayer(plr) end
            if updateConnection then
                updateConnection:Disconnect()
                updateConnection = nil
            end
        end
    end,
})

-- WalkSpeed Toggle
PlayerTab:AddToggle("WalkToggle", {
    Title = "WalkSpeed",
    Description = "Persistent walk speed modification",
    Default = false,
    Callback = function(enabled)
        State.WalkEnabled = enabled
        applyWalkSpeed()
        if enabled then
            if not WalkCons.charAdded then
                WalkCons.charAdded = LocalPlayer.CharacterAdded:Connect(onWalkCharacterAdded)
            end
        else
            if WalkCons.charAdded then
                WalkCons.charAdded:Disconnect()
                WalkCons.charAdded = nil
            end
        end
    end,
})

