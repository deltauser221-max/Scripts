-- ======================================================================
-- Player Tab – ESP (Team Aware) + WalkSpeed + Jump Power + Auto Refresh
-- Fully respawn‑proof, team colors update dynamically.
-- Auto Refresh toggles ESP off/on every 5 seconds.
-- ======================================================================

print("Player Tab script started")

